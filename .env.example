# Public Google OAuth Client ID (safe to expose in frontend code — never put
# the client secret here; secrets belong server-side only).
VITE_GOOGLE_CLIENT_ID=

# Base URL of the real backend, matching docs/api/openapi.yaml (e.g.
# http://localhost:8080/api/v1 for local dev, per that contract's "servers" list).
# Leave EMPTY to keep using the local mock AuthClient — see authClient.ts.
VITE_API_BASE_URL=
